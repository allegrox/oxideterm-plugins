{
  "id": "com.oxideterm.microcon-helper",
  "name": "MicroCon Helper",
  "version": "0.3.0",
  "description": "Configure MicroCon UART bridge and monitor status.",
  "author": "xiaox",
  "license": "MIT",
  "runtime": {
    "kind": "process",
    "entry": "bin/plugin"
  },
  "permissions": {
    "capabilities": [
      "ui.write",
      "ble.read",
      "ble.write",
      "terminal.content.read",
      "terminal.write"
    ]
  },
  "locales": "locales",
  "contributes": {
    "terminalHooks": {
      "inputInterceptor": true
    },
    "tabs": [
      {
        "id": "microcon-helper",
        "title": "MicroCon Helper",
        "icon": "bluetooth"
      }
    ],
    "terminalToolbar": [
      {
        "id": "mc-helper-mode",
        "labelKey": "toolbarButton",
        "states": [
          { "id": "off", "labelKey": "toolbarModeOff" },
          { "id": "inline", "labelKey": "toolbarModeInline" },
          { "id": "overlay", "labelKey": "toolbarModeOverlay", "overlay": true }
        ],
        "overlayTab": "microcon-helper",
        "defaultState": "off",
        "disabledHintKey": "toolbarUnavailable"
      }
    ]
  },
  "engines": {
    "oxideterm": ">=2.3.2"
  }
}
